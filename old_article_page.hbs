    <script>
    //dynamic placeholder in searchbar
  var gtext = $("span#search_placeholder_text").data('value');
  $('#query').attr('placeholder', gtext);
    </script>
<script language="JavaScript">
function toggletext(cid)
{
if ( document.getElementById(cid).style.display == "none" )
{
document.getElementById(cid).style.display = "block";
}
else
{
document.getElementById(cid).style.display = "none";
};
}
</script>


<section class="sub-nav-wrapper">
  <div class="container">
    <nav class="sub-nav">
  {{breadcrumbs}}
   {{search submit=false instant=true class='search'}}
      
</nav>

      <script>
        var catID = $('.breadcrumbs li:nth-child(2) a')
          .attr('href').match(/[0-9]+/)[0]
      </script>
  </div>
</section>

<div class="container">

  <div class="article-content-area" id="article-content-area">
    {{#if settings.sidebar_block_visibility}}
    <section class="sidebar collapsible-sidebar">
      <h3 class="collapsible-sidebar-title sidenav-title menu-title">
        {{#is settings.article_menu_title_dc 'NONE'}}{{settings.article_menu_title}}{{else}}{{dc settings.article_menu_title_dc }}{{/is}}
      </h3>
      <div class="diziana-category-sidebar-menu"></div>
    </section>
    {{/if}}

    <section class=" article-content-block">
      {{#if settings.show_articles_in_section}}
        <div class="article-section-sidebar collapsible-sidebar">
          <section class="article-sidebar">

          </section>
        </div>
      {{/if}}
      <article class="article">
        <header class="article-header {{#is settings.meta_block_visibility 'hide'}}follow_nowrap{{/is}}">
          <strong><font size="+3" title="{{article.title}}" class="article-title">
            {{article.title}} {{#if article.internal}}
            {{/if}}

          {{#if settings.follow_button_visibility}}
            {{subscribe}}
            {{/if}}
            </font></strong>
          {{#if settings.meta_block_visibility}}
          <div class="article-author">
            <div class="avatar article-avatar">
              {{#if article.author.agent}}
              <span class="icon-agent"></span>
              {{/if}}
              <img src="{{article.author.avatar_url}}" alt="Avatar" class="user-avatar" />
            </div>
            <div class="article-meta">
              {{#link 'user_profile' id=article.author.id}} {{article.author.name}} {{/link}}

              <ul class="meta-group">
                {{#is article.created_at article.edited_at}}
                <li class="meta-data">{{date article.created_at timeago=true}}</li>
                {{else}}
                <li class="meta-data">{{date article.edited_at timeago=true}}</li>
                <li class="meta-data">{{t 'updated'}}</li>
                {{/is}}
              </ul>
            </div>
          </div>
          {{/if}}
        </header>

        <section class="article-info">
          <div class="article-content {{#is settings.meta_block_visibility 'hide'}}article-content-margin{{/is}}">
            <div class="article-body">{{article.body}}</div>

            <div class="article-attachments">
              <ul class="attachments">
                {{#each attachments}}
                <li class="attachment-item">
                  <a href="{{url}}" target="_blank" title="{{name}}">{{name}}</a>
                  <div class="attachment-meta meta-group">
                    <span class="attachment-meta-item meta-data">{{size}}</span>
                    <a href="{{url}}" target="_blank" class="attachment-meta-item meta-data" title="{{t 'download'}}">{{t 'download'}}</a>
                  </div>
                </li>
                {{/each}}
              </ul>
            </div>
          </div>
        </section>

  <footer>
          <div class="article-footer">
            {{#if settings.article_share_block_visibility }}
            <div class="article-share">{{share}}</div>
            {{/if}}
        

		{{#if settings.comment_block_visibility}} {{#if comments}}
            <a href="#article-comments" class="article-comment-count" title="{{article.comment_count}}">
              <span class="icon-comments"></span>
              {{article.comment_count}}
            </a>
            {{/if}} {{/if}}
          </div>
    {{#with article}}
    
      <div class="article-votes">
        <span class="article-votes-question">Did you find this article helpful?</span>
       <div class="article-votes-controls" role='radiogroup'>
         <p style="display:inline-block" onclick="toggletext('mytext2')">{{vote 'up' selected_class='article-voted' role='radio' class='button article-vote article-vote-up'}} 
<p style="display:inline-block" onclick="toggletext('mytext')">{{vote 'down' class='button article-vote article-vote-down' selected_class='article-voted' role='button'}}</p>
         </div> 
            .<div class="up-vote-feedback" id="mytext2" style="display: none;">
 
</div>
      </div> 
            <div class="down-vote-feedback" id="mytext" style="display: none;">
