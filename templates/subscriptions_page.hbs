<script>
  var _templateName = "subscriptions-page";
</script>

<section class="hero {{#if settings.show_bg_image}}hero-image{{/if}}">
  <div class="hero-inner">
  {{#isnt settings.welcome_message_title 'HIDE_ME'}}
      <h1 class="welcome-message">
        {{#is settings.welcome_message_title_dc 'NONE'}}{{settings.welcome_message_title}}{{else}}{{dc settings.welcome_message_title_dc}}{{/is}}
      </h1>
    {{/isnt}}
    {{search instant=true class='search search-full'}}
    {{#isnt settings.search_placeholder_text 'NONE'}}
    <span id="search_placeholder_text" data-value="{{#is settings.search_placeholder_text_dc 'NONE'}}{{settings.search_placeholder_text}}{{else}}{{dc settings.search_placeholder_text_dc}}{{/is}}">
    </span>
    <script>
    //dynamic placeholder in searchbar
  var gtext = $("span#search_placeholder_text").data('value');
  $('#query').attr('placeholder', gtext);
    </script>
     {{/isnt}}
  </div>
</section>

<section class="sub-nav-wrapper">
  <div class="container">
    <nav class="sub-nav">
      {{breadcrumbs}}
    </nav>
  </div>
</section>

<nav class="my-activities-nav collapsible-nav r-list">
  <ul class="collapsible-nav-list container">
    {{#if help_center.request_management_enabled}}
    <li>{{link 'requests'}}</li>
    {{/if}}
    <li>{{link 'contributions'}}</li>
    <li aria-selected=true>{{t 'following'}}</li>
  </ul>
</nav>

<div class="container">
  <header class="my-activities-header">
    <h1>{{t 'following'}}</h1>
  </header>

  <div class="my-activities-following-header">
    <span class="dropdown">
      <span class="dropdown-toggle button">
        {{current_filter.label}}
      </span>
      <span class="dropdown-menu" role="menu">
        {{#each filters}}
        <a href="{{url}}" aria-selected="{{selected}}" role="menuitem" title="{{name}}">
          {{name}}
        </a>
        {{/each}}
      </span>
    </span>
  </div>

  <div class="requests">
    {{#if subscriptions}}
    <table class="table my-activities-table subscriptions-table">
      <thead>
        <tr>
          <th>{{t 'title'}}</th>
          <th>{{t 'type'}}</th>
          <th>{{t 'subscription'}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each subscriptions}}
        <tr>
          <td>
            {{#is type 'user'}}
            <img class="user-avatar" src="{{avatar_url}}" alt="Avatar"> {{/is}}
            <a href="{{url}}" title="{{title}}" class="striped-list-title">
              {{excerpt title characters=60}}
            </a>
          </td>
          <td>{{name}}</td>
          <td>{{subscribe}}</td>
          <td class="subscriptions-unsubscribe">{{unsubscribe}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    {{pagination}} {{else}}
    <p class="no-activities">{{t 'not_following'}}</p>
    {{/if}}
  </div>
</div>