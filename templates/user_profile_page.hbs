<script>
  var _templateName = "user-profile-page";
</script>

<section class="vs-hero" role="region" aria-label="Help center hero">
  <div class="vs-hero-inner">
      <a href="https://support.vanillasoft.com/hc/en-us" class="vs-hero-title">
        Vanillasoft Help Center
      </a>

<p class="vs-omnisearch-subtext">Search Vanillasoft guides and FAQs</p>
<div class="vs-omnisearch" data-enhanced="true">
  <div class="vs-omnisearch-shell">
       <svg class="vs-omnisearch-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.71.71l.27.28v.79L20 20.5 20.5 20l-5-6zM10 15a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/>
    </svg>
          <form class="vs-omnisearch-form" role="search" action="/hc/en-us/search" method="get" aria-label="Search the help center">       
            {{search instant=true class="search search-full vs-instant-form"}}
          </form>
        </div>

<div class="vs-omnisearch-action">
  </div>
      </div>
    </div>

  <div class="vs-hero-shape vs-hero-shape-a" aria-hidden="true"></div>
  <div class="vs-hero-shape vs-hero-shape-b" aria-hidden="true"></div>
</section>

<script>
  // “/” focuses the search
  document.addEventListener('keydown', e => {
    if (e.key === '/' && !/INPUT|TEXTAREA/.test(document.activeElement.tagName)) {
      const q = document.getElementById('query'); if (q) { e.preventDefault(); q.focus(); q.select(); }
    }
  });

  // Wire the external button to submit the proxy form with the live query value
  (function () {
    const q = document.getElementById('query');
    const proxy = document.getElementById('vs-omni-proxy');
    const btn = document.querySelector('.vs-omnisearch-submit');
    const proxyForm = document.getElementById('vs-omni-form-fix');
    if (!q || !proxy || !btn || !proxyForm) return;
    btn.addEventListener('click', function () {
      proxy.value = q.value || '';
      proxyForm.submit();
    });
  })();

  (function () {
  var form  = document.querySelector('.vs-omnisearch-shell form.search');
  var btn   = document.getElementById('vs-search-submit');
  if (form && btn) btn.addEventListener('click', function(){ form.submit(); });
})();
  
  document.addEventListener("DOMContentLoaded", function () {
  const shells = document.querySelectorAll(".vs-omnisearch-shell");
  shells.forEach(shell => {
    const input = shell.querySelector("input[type='search']");
    const btn = shell.querySelector(".vs-omnisearch-submit");

    if (input) {
      input.addEventListener("mouseenter", () => shell.classList.add("hover-input"));
      input.addEventListener("mouseleave", () => shell.classList.remove("hover-input"));
    }

    if (btn) {
      btn.addEventListener("mouseenter", () => shell.classList.remove("hover-input"));
      btn.addEventListener("mouseleave", () => shell.classList.remove("hover-input"));
    }
  });
});
</script>



<hr style="height:1px;visibility:hidden">

<header class="profile-header">
  <div class="container">
    <div class="profile-info">
      <div class="avatar profile-avatar">

        <img class="user-avatar" src="{{settings.favicon}}" alt="{{user.name}}">
      </div>
      <div class="basic-info">
        <h1 class="name">
          {{#if user.url}}
          <a href="{{user.url}}" target="_zendesk_lotus" title="{{t 'open_user_in_support'}}">{{user.name}}</a>
          {{else}} {{user.name}} {{/if}}
        </h1>
      </div>
     

      {{#if description}}
      <p class="description">{{description}}</p>
      {{/if}}


  </div>  </div>
</header>

{{#if visible}} {{#if member_since}}

<nav class="profile-nav collapsible-nav">
  <ul class="collapsible-nav-list container">
    {{#each filters}} {{#if selected}}
    <li aria-selected=true>{{name}}</li>
    {{else}}
    <li>
      <a href="{{url}}" title="{{name}}">{{name}}</a>
    </li>
    {{/if}} {{/each}}
  </ul>
</nav>

{{#is filter_by 'activities'}}
<div class="container">
  <section class="profile-section">

    {{#if activities}}

    <header class="profile-section-header">
      <h2 class="profile-section-title">{{t 'activity_overview'}}</h2>
      <span class="profile-section-description">{{t 'latest_activity' name=user.name}}</span>
    </header>

    <ul class="profile-activity-list">
      {{#each activities}}

      <li class="profile-activity profile-activity-{{type}}">
        <header class="profile-activity-header">
          <img class="user-avatar" src="{{../user.avatar_url}}" alt="Avatar" />
          <p class="profile-activity-description">{{label}}</p>
        </header>

        {{#with contribution}}
        <div class="profile-activity-contribution profile-contribution">
          <header class="profile-contribution-header">
            {{#isnt object_type 'comment'}}
            <h3 class="profile-contribution-title">
              <a href="{{url}}" title="{{title}}">{{title}}</a>
            </h3>
            {{/isnt}} {{#isnt status 'none'}}
            <span class="status-label status-label-{{status_dasherized}}">{{status_name}}</span>
            {{/isnt}} {{#if pending}}
            <span class="status-label status-label-pending">{{t 'pending_approval'}}</span>
            {{/if}} {{#if official}}
            <span class="status-label status-label-official">{{t 'official_comment'}}</span>
            {{/if}}
          </header>

          <ol class="breadcrumbs profile-contribution-breadcrumbs">
            {{#each path_steps}}
            <li title="{{name}}">
              <a href="{{url}}" title="{{name}}">{{name}}</a>
            </li>
            {{/each}}
          </ol>

          <p class="profile-contribution-body">{{excerpt body characters=200}}</p>

          <ul class="meta-group">
            {{#is object_type 'comment'}}
            <li class="meta-data">
              <a class="comment-link" href="{{url}}">{{t 'view_comment'}}</a>
            </li>
            {{/is}}
            <li class="meta-data">{{author.name}}</li>
            {{#if editor}}
            <li class="meta-data">{{date edited_at timeago=true}}</li>
            <li class="meta-data">
              {{#is object_type 'article'}} {{t 'updated'}} {{else}} {{t 'edited'}} {{/is}}
            </li>
            {{else}}
            <li class="meta-data">{{date created_at timeago=true}}</li>
            {{/if}} {{#each stats}}
            <li class="meta-data">{{label}}</li>
            {{/each}}
          </ul>
        </div>
        {{/with}}
      </li>

      {{/each}}
    </ul>

    {{/if}} {{#unless activities}}
    <span class="no-activity">{{t 'no_contributions'}}</span>
    {{/unless}}

  </section>
</div>
{{/is}} {{#isnt filter_by 'activities'}}
<div class="container">
  <section class="profile-section">

    {{#if contributions}}

    <header class="profile-section-header">
      <h2 class="profile-section-title">{{t filter_by}}</h2>
      {{#if sorters}}
      <span class="profile-section-description">{{sorter_description}}</span>
      <span class="profile-section-sorter dropdown">
        <span class="dropdown-toggle">
          {{current_sorter.label}}
        </span>
        <span class="dropdown-menu" role="menu">
          {{#each sorters}}
          <a href="{{url}}" aria-selected="{{selected}}" role="menuitem" title="{{name}}">
            {{name}}
          </a>
          {{/each}}
        </span>
      </span>
      {{/if}}
    </header>

    <ul class="profile-contribution-list profile-{{filter_by}}">
      {{#each contributions}}

      <li class="profile-contribution">
        <header class="profile-contribution-header">
          {{#isnt object_type 'comment'}}
          <h3 class="profile-contribution-title">
            <a href="{{url}}" title="{{title}}">{{title}}</a>
          </h3>
          {{/isnt}} {{#isnt status 'none'}}
          <span class="status-label status-label-{{status_dasherized}}">{{status_name}}</span>
          {{/isnt}} {{#if pending}}
          <span class="status-label status-label-pending">{{t 'pending_approval'}}</span>
          {{/if}} {{#if official}}
          <span class="status-label status-label-official">{{t 'official_comment'}}</span>
          {{/if}}
        </header>

        <ol class="breadcrumbs profile-contribution-breadcrumbs">
          {{#each path_steps}}
          <li title="{{name}}">
            <a href="{{url}}" title="{{name}}">{{name}}</a>
          </li>
          {{/each}}
        </ol>

        <p class="profile-contribution-body">{{excerpt body characters=200}}</p>

        <ul class="meta-group">
          {{#is object_type 'comment'}}
          <li class="meta-data">
            <a class="comment-link" href="{{url}}">{{t 'view_comment'}}</a>
          </li>
          {{/is}}
          <li class="meta-data">{{author.name}}</li>
          {{#if editor}}
          <li class="meta-data">{{date edited_at timeago=true}}</li>
          <li class="meta-data">
            {{#is object_type 'article'}} {{t 'updated'}} {{else}} {{t 'edited'}} {{/is}}
          </li>
          {{else}}
          <li class="meta-data">{{date created_at timeago=true}}</li>
          {{/if}} {{#each stats}}
          <li class="meta-data">{{label}}</li>
          {{/each}}
        </ul>
      </li>

      {{/each}}
    </ul>

    {{pagination}} {{/if}} {{#unless contributions}}
    <span class="no-activity">{{t 'no_contributions'}}</span>
    {{/unless}}

  </section>
</div>

{{/isnt}} {{/if}} {{#unless member_since}}
<div class="container">
  <section class="profile-section">
    <span class="no-activity">{{t 'no_content_yet'}}</span>
  </section>
</div>
{{/unless}} {{/if}} {{#unless visible}}
<div class="container">
  <section class="profile-section">
    <span class="private-activity">{{t 'private_activity'}}</span>
  </section>
</div>
{{/unless}}