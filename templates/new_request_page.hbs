<script>
document.addEventListener('DOMContentLoaded', function () {
  var cb   = document.getElementById('request_custom_fields_41617844725147');
  var wrap = document.querySelector('.form-field.request_custom_fields_41617915210011');
  var inp  = document.getElementById('request_custom_fields_41617915210011');

  if (!cb || !wrap || !inp) return;

  function sync() {
    if (cb.checked) {
      wrap.classList.add('is-shown');
      wrap.removeAttribute('hidden');
      inp.disabled = false;
    } else {
      wrap.classList.remove('is-shown');
      wrap.setAttribute('hidden', '');
      inp.disabled = true;
    }
  }

  sync();
  cb.addEventListener('change', sync);
});
</script>

<script>
(function () {
  var signedIn = {{#if signed_in}}true{{else}}false{{/if}};
  if (signedIn) document.body.classList.add('vs-signed-in');

  var FIELD_SELECTORS = [
    '.request_custom_fields_40754361059739',
    '.request_custom_fields_38050731911195',
    '.request_custom_fields_38050792871579',
    '.request_custom_fields_41617844725147',
    '.request_custom_fields_38081504914587',
    '#vs-login-email-field',
    '.request_custom_fields_41617915210011',
    '.request_anonymous_requester_email'
  ];

  function hideFieldHard(selector){
    var el = document.querySelector(selector);
    if (!el) return;
    el.style.setProperty('display','none','important');
    el.querySelectorAll('input,select,textarea').forEach(function(i){
      if (i.type !== 'hidden') i.disabled = true;
    });
  }

  if (signedIn) FIELD_SELECTORS.forEach(hideFieldHard);

  if (signedIn) {
    var hint = document.getElementById('request_custom_fields_41617844725147_hint');
    if (hint) hint.style.setProperty('display','none','important');
  }
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var wrap  = document.querySelector('.form-field.request_anonymous_requester_email');
  var input = document.getElementById('request_anonymous_requester_email');
  if (!wrap || !input) return;

  var existingHint = wrap.querySelector('#request_anonymous_requester_email_hint');
  if (!existingHint) {
    var hint = document.createElement('p');
    hint.id  = 'request_anonymous_requester_email_hint';
    hint.textContent = 'Enter the email address where we should send updates.';
    wrap.appendChild(hint);
  }

  var describedby = (input.getAttribute('aria-describedby') || '').trim();
  if (!/\brequest_anonymous_requester_email_hint\b/.test(describedby)) {
    input.setAttribute(
      'aria-describedby',
      (describedby ? describedby + ' ' : '') + 'request_anonymous_requester_email_hint'
    );
  }
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const box = document.getElementById('request_custom_fields_41617844725147');
  const hint = document.getElementById('request_custom_fields_41617844725147_hint');
  if (!box || !hint) return;

  hint.setAttribute('tabindex', '0');
  hint.style.cursor = 'pointer';

  function toggle() { box.checked = !box.checked; box.dispatchEvent(new Event('change', {bubbles:true})); }
  hint.addEventListener('click', toggle);
  hint.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
  });

  box.setAttribute('aria-labelledby', hint.id);
});
</script>
