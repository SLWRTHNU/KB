<style>
  .accordion {
  width: 100%;
  display: flex;
  align-items: left;
  justify-content: space-between;
  background: #fff;
  color: #1E5598;
  cursor: pointer;
  padding: 0 20px;
  border: 1px solid #e4e7ec;
  border-radius: 12px;
  font-family: "Source Sans Pro", system-ui, -apple-system, Segoe UI, sans-serif;
  text-align: left;
  box-shadow: 0 2px 6px rgba(0,0,0,.08);
  transition: all .25s ease;
}

/* Make the chevron live on the far right */
.accordion::after {
  content: "›";
  rotate: 90deg;
  font-size: 20px;
  color: #2474BB;
  margin-left: auto;             /* pushes chevron to the end */
  transition: all .25s ease;
}

/* Add the “- Click to expand” inline with the title */
.accordion > summary {
  margin: 0;
  font-weight: 700;
  color: #1E5598;
}

.accordion[aria-expanded="true"] + .panel,
.accordion.active + .panel {
  max-height: 1000px;
  padding: 0 14px 14px;
}
  
  .panel {
  position: relative;
  overflow: hidden;
  max-height: 0;
  background: #fff;
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
  padding: 0 200px;
  transition: all .25s ease;
}

.panel::before {
  content: "";
  position: absolute;
  inset: 0;
  border: 1px solid rgba(180,185,189,0.6);
  border-top: none;
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease;
}  
  
  .panel.open {
  padding: 12px 14px 14px;
  max-height: 1000px;
}

.accordion + .panel {
  margin-bottom: 8px;
}

/* Keep your open/active styles as-is; example for chevron flip */
.accordion[aria-expanded="true"]::after {
  transform: scaleX(-1);
  }
    
/* Parent might be centered—reset it */
#vs-footer-mobile .vs-accordion,
#vs-footer-mobile .accordion { text-align: left; }

/* Keep the content of the bar left-aligned */
#vs-footer-mobile .accordion {
  justify-content: flex-start;   /* left-align the row */
}

/* Make the summary behave like a left-aligned flex item */
#vs-footer-mobile .accordion > summary {
  display: flex;
  align-items: center;
  margin: 0;                     /* kill any UA centering */
  text-align: left;
}

/* Hide default summary marker so it doesn't affect alignment */
#vs-footer-mobile .accordion > summary::marker,
#vs-footer-mobile .accordion > summary::-webkit-details-marker { display: none; }

/* (Optional) keep your chevron on the far right */
#vs-footer-mobile .accordion::after { margin-left: auto; }

    
    </style>




